# Copy to .env and adjust as needed.

# Port the backend HTTP + WebSocket server listens on
PORT=4000

# Probability (0–1) that each simulator tick injects an attack scenario.
# Raise this for heavy testing (e.g. 0.5), lower it for quieter demos (e.g. 0.02).
ATTACK_CHANCE=0.08

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173
